{
  "ok": true,
  "protocol": "typed-json",
  "version": "typed-json-v1",
  "diagnostics": [],
  "program": {
    "root": "expense-review-card",
    "nodes": [
      {
        "kind": "Text",
        "id": "review-instructions",
        "text": "Review routine operating expenses and approve the pending expense."
      },
      {
        "kind": "Input",
        "id": "review-note-input",
        "label": "Review note",
        "state_key": "review_note",
        "value": ""
      },
      {
        "kind": "Select",
        "id": "status-filter-select",
        "label": "Status",
        "state_key": "status_filter",
        "options": [
          "all",
          "pending",
          "approved"
        ],
        "value": "pending"
      },
      {
        "kind": "Table",
        "id": "expense-table",
        "columns": [
          "expense_id",
          "merchant",
          "amount",
          "status"
        ],
        "rows": [
          {
            "expense_id": "exp-001",
            "merchant": "Wide World Courier",
            "amount": "EUR 58.40",
            "status": "pending"
          },
          {
            "expense_id": "exp-002",
            "merchant": "City Print",
            "amount": "EUR 112.00",
            "status": "pending"
          }
        ]
      },
      {
        "kind": "Button",
        "id": "approve-exp001-button",
        "label": "Approve exp-001",
        "action": {
          "name": "ApproveExpense",
          "expense_id": "exp-001"
        }
      },
      {
        "kind": "Alert",
        "id": "approval-result-alert",
        "tone": "info",
        "message": "Approval result will appear here."
      },
      {
        "kind": "Stack",
        "id": "expense-review-stack",
        "children": [
          "review-instructions",
          "review-note-input",
          "status-filter-select",
          "expense-table",
          "approve-exp001-button",
          "approval-result-alert"
        ]
      },
      {
        "kind": "Card",
        "id": "expense-review-card",
        "title": "Expense Review",
        "child": "expense-review-stack"
      }
    ]
  }
}