{
  "ok": true,
  "protocol": "typed-json",
  "version": "typed-json-v1",
  "diagnostics": [],
  "program": {
    "root": "expense-review-card",
    "nodes": [
      {
        "kind": "Text",
        "id": "review-instructions",
        "text": "Review high-value expenses and approve expense exp-001."
      },
      {
        "kind": "Table",
        "id": "expense-table",
        "columns": [
          "expense_id",
          "merchant",
          "amount",
          "status"
        ],
        "rows": [
          {
            "expense_id": "exp-001",
            "merchant": "Pro Workstations",
            "amount": "EUR 3,890.00",
            "status": "pending"
          },
          {
            "expense_id": "exp-002",
            "merchant": "Studio Displays",
            "amount": "EUR 1,640.00",
            "status": "pending"
          }
        ]
      },
      {
        "kind": "Input",
        "id": "review-note",
        "label": "Review note",
        "state_key": "review_note",
        "value": ""
      },
      {
        "kind": "Select",
        "id": "status-filter",
        "label": "Status filter",
        "state_key": "status_filter",
        "options": [
          "all",
          "pending",
          "approved"
        ],
        "value": "pending"
      },
      {
        "kind": "Button",
        "id": "approve-exp-001",
        "label": "Approve exp-001",
        "action": {
          "name": "ApproveExpense",
          "expense_id": "exp-001"
        }
      },
      {
        "kind": "Alert",
        "id": "approval-result",
        "tone": "success",
        "message": "Approval submitted for expense exp-001."
      },
      {
        "kind": "Stack",
        "id": "expense-review-stack",
        "children": [
          "review-instructions",
          "expense-table",
          "review-note",
          "status-filter",
          "approve-exp-001",
          "approval-result"
        ]
      },
      {
        "kind": "Card",
        "id": "expense-review-card",
        "title": "High-value expense review",
        "child": "expense-review-stack"
      }
    ]
  }
}