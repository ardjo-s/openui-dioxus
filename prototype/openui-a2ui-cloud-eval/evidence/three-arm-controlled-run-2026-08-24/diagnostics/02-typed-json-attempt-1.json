{
  "ok": true,
  "protocol": "typed-json",
  "version": "typed-json-v1",
  "diagnostics": [],
  "program": {
    "root": "expense-review-card",
    "nodes": [
      {
        "kind": "Text",
        "id": "review-heading",
        "text": "Review routine operating expenses"
      },
      {
        "kind": "Input",
        "id": "review-note",
        "label": "Review note",
        "state_key": "review_note",
        "value": ""
      },
      {
        "kind": "Select",
        "id": "status-filter",
        "label": "Status",
        "state_key": "status_filter",
        "options": [
          "all",
          "pending",
          "approved"
        ],
        "value": "pending"
      },
      {
        "kind": "Table",
        "id": "expense-table",
        "columns": [
          "expense_id",
          "merchant",
          "amount",
          "status"
        ],
        "rows": [
          {
            "expense_id": "exp-001",
            "merchant": "Contoso Rail",
            "amount": "EUR 164.50",
            "status": "pending"
          },
          {
            "expense_id": "exp-002",
            "merchant": "Tailspin Meals",
            "amount": "EUR 86.20",
            "status": "pending"
          }
        ]
      },
      {
        "kind": "Button",
        "id": "approve-exp-001",
        "label": "Approve exp-001",
        "action": {
          "name": "ApproveExpense",
          "expense_id": "exp-001"
        }
      },
      {
        "kind": "Alert",
        "id": "approval-result",
        "tone": "success",
        "message": "Expense exp-001 approved."
      },
      {
        "kind": "Stack",
        "id": "expense-review-stack",
        "children": [
          "review-heading",
          "review-note",
          "status-filter",
          "expense-table",
          "approve-exp-001",
          "approval-result"
        ]
      },
      {
        "kind": "Card",
        "id": "expense-review-card",
        "title": "Expense Review",
        "child": "expense-review-stack"
      }
    ]
  }
}