root = Card("review-card", "Travel Expense Review — Paris", content)
content = Stack("review-content", [context, expenses, note, filter, approve, result])
context = Text("context", "Review policy-sensitive lodging and transport expenses.")
expenses = Table("expenses", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Paris Central Hotel", "amount": "EUR 690.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Metro Mobility", "amount": "EUR 43.60", "status": "pending"}])
note = Input("review-note", "Reviewer note", "review_note", "")
filter = Select("status-filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
approve = Button("approve-exp-001", "Approve Paris Central Hotel", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval-result", "success", "Expense exp-001 approved.")