root = Card("expense-review", "Expense Review", content)
content = Stack("review-content", [heading, filters, expenses, note, approve, result])
heading = Text("duplicate-risk", "Duplicate-risk inspection")
filters = Select("status-filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
expenses = Table("expense-table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Northwind Catering", "amount": "EUR 320.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Northwind Caterers", "amount": "EUR 320.00", "status": "pending"}])
note = Input("review-note", "Reviewer note", "review_note", "")
approve = Button("approve-exp-001", "Approve exp-001", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval-result", "success", "Expense exp-001 approved.")