root = Card("expense-review", "Travel Expense Review", content)
content = Stack("review-content", [context, expenses, note, filter, approve, result])
context = Text("review-context", "Review Lisbon travel expenses for policy-sensitive lodging and transport costs.")
expenses = Table("expense-table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Lisbon Riverside Rooms", "amount": "EUR 465.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Atlantic Air", "amount": "EUR 312.40", "status": "pending"}])
note = Input("review-note", "Reviewer note", "review_note", "")
filter = Select("status-filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
approve = Button("approve-exp-001", "Approve exp-001", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval-result", "info", "Expense exp-001 is ready for approval.")