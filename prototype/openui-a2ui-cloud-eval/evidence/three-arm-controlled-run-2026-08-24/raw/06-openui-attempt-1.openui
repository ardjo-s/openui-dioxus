root = Card("root", "Travel Expense Review", content)
content = Stack("content", [context, filter, expenses, note, approve, result])
context = Text("context", "Review policy-sensitive lodging and transport costs.")
filter = Select("filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
expenses = Table("expenses", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Berlin Business Stay", "amount": "EUR 540.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Bahn Connect", "amount": "EUR 128.00", "status": "pending"}])
note = Input("note", "Reviewer note", "review_note", "")
approve = Button("approve", "Approve Berlin Business Stay", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("result", "info", "Expense exp-001 is ready for approval.")