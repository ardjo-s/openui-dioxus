root = Card("expense_review", "Vendor Expense Review", content)
content = Stack("review_content", [identity, status_filter, expenses, reviewer_note, approval, result])
identity = Text("vendor_identity", "Vendor compliance review")
status_filter = Select("status_filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
expenses = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Baltic Components", "amount": "EUR 920.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Local Parts Depot", "amount": "EUR 275.00", "status": "pending"}])
reviewer_note = Input("reviewer_note", "Reviewer note", "review_note", "")
approval = Button("approve_exp001", "Approve Baltic Components", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval_result", "success", "Expense exp-001 approved successfully.")