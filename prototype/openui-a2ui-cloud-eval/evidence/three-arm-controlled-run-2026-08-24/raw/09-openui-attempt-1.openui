root = Card("expense_review", "Expense Review", content)
content = Stack("review_content", [context, filter, expenses, note, approve, result])
context = Text("duplicate_risk", "Similar merchants and amounts detected; inspect for duplicate risk.")
filter = Select("status_filter_control", "Status", "status_filter", ["all", "pending", "approved"], "pending")
expenses = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Cloud Harbor", "amount": "EUR 249.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Cloud Harbor EU", "amount": "EUR 249.00", "status": "pending"}])
note = Input("review_note_input", "Reviewer note", "review_note", "")
approve = Button("approve_expense", "Approve exp-001", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval_result", "success", "Expense exp-001 approved.")