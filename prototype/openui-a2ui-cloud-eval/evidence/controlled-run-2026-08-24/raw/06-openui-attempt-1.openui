root = Card("expense-review", "Travel Expense Review", content)
content = Stack("review-content", [context, expenses, note, filter, approve, result])
context = Text("policy-context", "Review lodging and transport costs for travel-policy sensitivity.")
expenses = Table("expense-table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Berlin Business Stay", "amount": "EUR 540.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Bahn Connect", "amount": "EUR 128.00", "status": "pending"}])
note = Input("review-note", "Reviewer note", "review_note", "")
filter = Select("status-filter", "Status", "status_filter", ["all", "pending", "approved"], "pending")
approve = Button("approve-exp-001", "Approve Berlin Business Stay", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval-result", "success", "Expense exp-001 approved.")