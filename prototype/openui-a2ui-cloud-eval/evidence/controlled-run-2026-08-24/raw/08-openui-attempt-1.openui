root = Card("expense_review", "Travel Expense Review", content)
content = Stack("review_content", [context, expenses, note, filter, approve, result])
context = Text("policy_context", "Review lodging and transport costs for travel-policy sensitivity.")
expenses = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id":"exp-001","merchant":"Milan Expo Hotel","amount":"EUR 735.00","status":"pending"},{"expense_id":"exp-002","merchant":"Italia Rail","amount":"EUR 146.80","status":"pending"}])
note = Input("review_note_input", "Reviewer note", "review_note", "")
filter = Select("status_filter_select", "Status", "status_filter", ["all", "pending", "approved"], "pending")
approve = Button("approve_expense", "Approve Milan Expo Hotel", {"name":"ApproveExpense","expense_id":"exp-001"})
result = Alert("approval_result", "success", "Expense exp-001 approved.")