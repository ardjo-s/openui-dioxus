root = Card("expense_review", "Duplicate-Risk Expense Review", content)
content = Stack("review_content", [context, expenses, note, filter, approve, result])
context = Text("duplicate_context", "Review similar merchants and amounts for duplicate risk.")
expenses = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id":"exp-001","merchant":"Dev Tools Pro","amount":"EUR 89.00","status":"pending"},{"expense_id":"exp-002","merchant":"DevTools Pro","amount":"EUR 89.00","status":"pending"}])
note = Input("review_note_input", "Reviewer note", "review_note", "")
filter = Select("status_filter_select", "Status", "status_filter", ["all", "pending", "approved"], "pending")
approve = Button("approve_exp001", "Approve exp-001", {"name":"ApproveExpense","expense_id":"exp-001"})
result = Alert("approval_result", "success", "Expense exp-001 approved.")