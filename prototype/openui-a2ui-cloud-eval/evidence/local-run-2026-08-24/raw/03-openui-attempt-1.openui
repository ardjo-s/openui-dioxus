root = Card("expense_review", "Expense Review", content)
content = Stack("review_content", [title, filter, expenses, note, approve, result])
title = Text("review_title", "Review expenses awaiting approval")
filter = Select("status_filter_select", "Status", "status_filter", ["pending", "approved", "rejected"], "pending")
expenses = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id": "exp-001", "merchant": "Acme Air", "amount": "EUR 420.00", "status": "pending"}, {"expense_id": "exp-002", "merchant": "Northwind Hotel", "amount": "EUR 280.00", "status": "pending"}])
note = Input("review_note_input", "Reviewer note", "review_note", "")
approve = Button("approve_expense", "Approve exp-001", {"name": "ApproveExpense", "expense_id": "exp-001"})
result = Alert("approval_result", "info", "Expense exp-001 is ready for approval.")