root = Card("expense_review", "Expense Review", review_content)
review_content = Stack("review_content", [intro, status_filter, expense_table, review_note, approve_button, result_alert])
intro = Text("intro", "Review pending expenses and approve exp-001.")
status_filter = Select("status_filter", "Status", "status_filter", ["pending", "approved", "rejected"], "pending")
expense_table = Table("expense_table", ["expense_id", "merchant", "amount", "status"], [{"expense_id":"exp-001","merchant":"Acme Air","amount":"EUR 420.00","status":"pending"},{"expense_id":"exp-002","merchant":"Northwind Hotel","amount":"EUR 280.00","status":"pending"}])
review_note = Input("review_note", "Reviewer note", "review_note", "")
approve_button = Button("approve_exp_001", "Approve exp-001", {"name":"ApproveExpense","expense_id":"exp-001"})
result_alert = Alert("approval_result", "success", "Expense exp-001 approved successfully.")