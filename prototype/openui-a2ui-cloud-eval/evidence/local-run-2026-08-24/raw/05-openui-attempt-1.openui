root = Card("expense-review-card", "Expense Review", content)
content = Stack("review-content", [intro, filter, expenses, note, approve, result])
intro = Text("review-intro", "Review pending expenses and approve eligible items.")
filter = Select("status-filter", "Status", "status_filter", ["pending", "approved", "rejected"], "pending")
expenses = Table("expense-table", ["expense_id", "merchant", "amount", "status"], [{"expense_id":"exp-001","merchant":"Acme Air","amount":"EUR 420.00","status":"pending"},{"expense_id":"exp-002","merchant":"Northwind Hotel","amount":"EUR 280.00","status":"pending"}])
note = Input("review-note", "Reviewer note", "review_note", "")
approve = Button("approve-exp-001", "Approve Acme Air", {"name":"ApproveExpense","expense_id":"exp-001"})
result = Alert("approval-result", "info", "Expense approval result will appear here.")