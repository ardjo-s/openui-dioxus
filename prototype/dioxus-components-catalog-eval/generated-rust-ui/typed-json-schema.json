{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openui-dioxus.dev/eval/rust-ui-dioxus-eval/0.0.1-ope10/surface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "nodes",
    "state"
  ],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Label"
          },
          {
            "$ref": "#/$defs/Card"
          },
          {
            "$ref": "#/$defs/Input"
          },
          {
            "$ref": "#/$defs/Checkbox"
          },
          {
            "$ref": "#/$defs/Button"
          },
          {
            "$ref": "#/$defs/Table"
          },
          {
            "$ref": "#/$defs/Progress"
          },
          {
            "$ref": "#/$defs/Alert"
          }
        ]
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_name": {
          "type": "string"
        },
        "terms_accepted": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "Label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "for_id",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "Label"
        },
        "id": {
          "type": "string"
        },
        "for_id": {
          "type": "string",
          "format": "component-id-ref"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "Card"
        },
        "id": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "component-ref"
          }
        }
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "state_key",
        "value",
        "placeholder"
      ],
      "properties": {
        "kind": {
          "const": "Input"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state_key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "Checkbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "state_key",
        "checked"
      ],
      "properties": {
        "kind": {
          "const": "Checkbox"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state_key": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        }
      }
    },
    "Button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "action",
        "target_id",
        "disabled"
      ],
      "properties": {
        "kind": {
          "const": "Button"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "submit_profile"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "caption",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "Table"
        },
        "id": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cells"
            ],
            "properties": {
              "cells": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "value",
        "max"
      ],
      "properties": {
        "kind": {
          "const": "Progress"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "Alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "title",
        "message",
        "tone"
      ],
      "properties": {
        "kind": {
          "const": "Alert"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      }
    }
  }
}
