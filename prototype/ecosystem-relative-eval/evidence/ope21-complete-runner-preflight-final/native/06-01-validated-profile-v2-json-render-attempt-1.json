{
  "root": "profile_toolbar",
  "elements": {
    "profile_toolbar": {
      "type": "Toolbar",
      "props": {
        "id": "profile_toolbar",
        "orientation": "vertical"
      },
      "children": [
        "profile_avatar",
        "name_label",
        "name_input",
        "submit_button"
      ]
    },
    "profile_avatar": {
      "type": "Avatar",
      "props": {
        "id": "profile_avatar",
        "alt": "Ada Lovelace · variant 2",
        "fallback": "AL"
      },
      "children": []
    },
    "name_label": {
      "type": "Label",
      "props": {
        "id": "name_label",
        "for_id": "name_input",
        "text": "Profile name · variant 2"
      },
      "children": []
    },
    "name_input": {
      "type": "Input",
      "props": {
        "id": "name_input",
        "label": "Profile name · variant 2",
        "state_key": "profile_name",
        "value": {
          "$bindState": "/profile_name"
        },
        "placeholder": "Enter a name · variant 2"
      },
      "children": []
    },
    "submit_button": {
      "type": "Button",
      "props": {
        "id": "submit_button",
        "label": "Save profile · variant 2"
      },
      "children": [],
      "on": {
        "press": {
          "action": "SubmitProfile",
          "params": {
            "target_id": "profile"
          }
        }
      }
    }
  },
  "state": {
    "profile_name": "Ada-2"
  }
}
