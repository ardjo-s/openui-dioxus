  "entries": [
    {
      "cohort": "runtime-uncertain",
      "schedule_scenario_id": "02-preferences-v1",
      "scenario_id": "02-preferences-v1",
      "family": "preferences",
      "spec": {
        "root": "preferences_toolbar",
        "elements": {
          "preferences_switch": {
            "type": "Switch",
            "props": {
              "id": "preferences_switch",
              "label": "Enable notifications · variant 1",
              "state_key": "notifications_enabled",
              "checked": {
                "$bindState": "/notifications_enabled"
              }
            },
            "children": []
          },
          "preferences_checkbox": {
            "type": "Checkbox",
            "props": {
              "id": "preferences_checkbox",
              "label": "Accept terms · variant 1",
              "state_key": "terms_accepted",
              "checked": {
                "$bindState": "/terms_accepted"
              }
            },
            "children": []
          },
          "preferences_apply": {
            "type": "Button",
            "props": {
              "id": "preferences_apply",
              "label": "Apply preferences"
            },
            "on": {
              "press": {
                "action": "ApplyFilter",
                "params": {
                  "target_id": "preferences"
                }
              }
            },
            "children": []
          },
          "preferences_toolbar": {
            "type": "Toolbar",
            "props": {
              "id": "preferences_toolbar",
              "orientation": "vertical"
            },
            "children": [
              "preferences_switch",
              "preferences_checkbox",
              "preferences_apply"
            ]
          }
        },
        "state": {
          "notifications_enabled": true,
          "terms_accepted": false
        }
      }
    },
    {
      "cohort": "compile-known",
      "schedule_scenario_id": "compile-04-status-dialog-v1",
      "scenario_id": "04-status-dialog-v1",
      "family": "status-dialog",
      "spec": {
        "root": "progress_toolbar",
        "elements": {
          "sync_progress": {
            "type": "Progress",
            "props": {
              "id": "sync_progress",
              "label": "Sync progress · variant 1",
              "value": 20,
              "max": 100
            },
            "children": []
          },
          "sync_button": {
            "type": "Button",
            "props": {
              "id": "sync_button",
              "label": "Acknowledge sync · variant 1"
            },
            "on": {
              "press": {
                "action": "ApplyFilter",
                "params": {
                  "target_id": "sync"
                }
              }
            },
            "children": []
          },
          "sync_dialog": {
            "type": "Dialog",
            "props": {
              "id": "sync_dialog",
              "title": "Syncing workspace · variant 1",
              "open_state_key": "dialog_open"
            },
            "children": [
              "sync_progress",
              "sync_button"
            ]
          },
          "progress_toolbar": {
            "type": "Toolbar",
            "props": {
              "id": "progress_toolbar",
              "orientation": "vertical"
            },
            "children": [
              "sync_dialog"
            ]
          }
        },
        "state": {
          "dialog_open": true
        }
      }
    }
