root = Toolbar("status_toolbar", "horizontal", [status_dialog])
status_dialog = Dialog("sync_dialog", "Syncing workspace · variant 3", "dialog_open", [progress_toolbar])
progress_toolbar = Toolbar("progress_toolbar", "vertical", [sync_progress, apply_filter])
sync_progress = Progress("sync_progress", "Sync progress · variant 3", 60, 100)
apply_filter = Button("apply_filter", "Apply filter", "ApplyFilter", "sync")