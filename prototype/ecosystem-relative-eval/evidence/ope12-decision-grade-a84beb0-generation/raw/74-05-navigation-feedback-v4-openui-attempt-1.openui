root = Toolbar("navigation_toolbar", "vertical", [tabs, feedback])
tabs = Tabs("activity_tabs", "active_tab", "activity", [{value: "activity", label: "Activity · variant 4", child: activity_panel}])
activity_panel = Button("apply_activity_filter", "Apply filter", "ApplyFilter", "activity")
feedback = Toast("activity_saved_feedback", "success", "Saved · variant 4", "Your activity view is current. · variant 4")