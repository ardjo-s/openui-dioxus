root = Toolbar("profile_toolbar", "vertical", [profile_avatar, name_label, name_input, submit_button])
profile_avatar = Avatar("profile_avatar", "Ada Lovelace · variant 1", "AL")
name_label = Label("name_label", "name_input", "Profile name · variant 1")
name_input = Input("name_input", "Profile name · variant 1", "profile_name", "Ada-1", "Enter a name · variant 1")
submit_button = Button("submit_button", "Save profile · variant 1", "SubmitProfile", "profile")