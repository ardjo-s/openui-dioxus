root = Toolbar("preferences_toolbar", "vertical", [notifications_switch, terms_checkbox, apply_filter_button])
notifications_switch = Switch("notifications_switch", "Enable notifications · variant 3", "notifications_enabled", true)
terms_checkbox = Checkbox("terms_checkbox", "Accept terms · variant 3", "terms_accepted", false)
apply_filter_button = Button("apply_filter_button", "Apply filter", "ApplyFilter", "preferences")