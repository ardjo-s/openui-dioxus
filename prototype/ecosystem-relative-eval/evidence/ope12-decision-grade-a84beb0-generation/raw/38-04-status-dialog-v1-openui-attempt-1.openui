root = Toolbar("status_toolbar", "horizontal", [sync_dialog])
sync_dialog = Dialog("sync_dialog", "Syncing workspace · variant 1", "dialog_open", [progress_toolbar])
progress_toolbar = Toolbar("progress_toolbar", "vertical", [sync_progress, sync_action])
sync_progress = Progress("sync_progress", "Sync progress · variant 1", 20, 100)
sync_action = Button("sync_action", "Apply filter", "ApplyFilter", "sync")