{
  "root": "preferences_toolbar",
  "elements": {
    "preferences_toolbar": {
      "type": "Toolbar",
      "props": {
        "id": "preferences_toolbar",
        "orientation": "vertical"
      },
      "children": [
        "notifications_switch",
        "terms_checkbox",
        "apply_filter_button"
      ]
    },
    "notifications_switch": {
      "type": "Switch",
      "props": {
        "id": "notifications_switch",
        "label": "Enable notifications · variant 3",
        "state_key": "notifications_enabled",
        "checked": {
          "$bindState": "/notifications_enabled"
        }
      },
      "children": []
    },
    "terms_checkbox": {
      "type": "Checkbox",
      "props": {
        "id": "terms_checkbox",
        "label": "Accept terms · variant 3",
        "state_key": "terms_accepted",
        "checked": {
          "$bindState": "/terms_accepted"
        }
      },
      "children": []
    },
    "apply_filter_button": {
      "type": "Button",
      "props": {
        "id": "apply_filter_button",
        "label": "Apply preferences"
      },
      "on": {
        "press": {
          "action": "ApplyFilter",
          "params": {
            "target_id": "preferences"
          }
        }
      },
      "children": []
    }
  },
  "state": {
    "notifications_enabled": true,
    "terms_accepted": false
  }
}
