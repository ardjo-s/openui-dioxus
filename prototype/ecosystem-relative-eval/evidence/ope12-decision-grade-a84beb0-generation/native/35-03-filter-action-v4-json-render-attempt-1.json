{
  "root": "filter_toolbar",
  "elements": {
    "filter_select": {
      "type": "Select",
      "props": {
        "id": "filter_select",
        "label": "Role · variant 4",
        "state_key": "role_filter",
        "options": [
          "All",
          "Admin",
          "Member"
        ],
        "value": {
          "$bindState": "/role_filter"
        }
      },
      "children": []
    },
    "apply_filter_button": {
      "type": "Button",
      "props": {
        "id": "apply_filter_button",
        "label": "Apply · variant 4"
      },
      "on": {
        "press": {
          "action": "ApplyFilter",
          "params": {
            "target_id": "people"
          }
        }
      },
      "children": []
    },
    "filter_toolbar": {
      "type": "Toolbar",
      "props": {
        "id": "filter_toolbar",
        "orientation": "horizontal"
      },
      "children": [
        "filter_select",
        "apply_filter_button"
      ]
    }
  },
  "state": {
    "role_filter": "All"
  }
}
