{
  "root": "navigation_toolbar",
  "elements": {
    "navigation_toolbar": {
      "type": "Toolbar",
      "props": {
        "id": "navigation_toolbar",
        "orientation": "vertical"
      },
      "children": [
        "account_tabs",
        "activity_button"
      ]
    },
    "account_tabs": {
      "type": "Tabs",
      "props": {
        "id": "account_tabs",
        "state_key": "active_tab",
        "value": "activity",
        "items": [
          {
            "value": "activity",
            "label": "Activity · variant 3"
          }
        ]
      },
      "children": [
        "saved_toast"
      ]
    },
    "saved_toast": {
      "type": "Toast",
      "props": {
        "id": "saved_toast",
        "tone": "success",
        "title": "Saved · variant 3",
        "message": "Your activity view is current. · variant 3"
      },
      "children": []
    },
    "activity_button": {
      "type": "Button",
      "props": {
        "id": "activity_button",
        "label": "Refresh activity · variant 3"
      },
      "children": [],
      "on": {
        "press": {
          "action": "ApplyFilter",
          "params": {
            "target_id": "activity"
          }
        }
      }
    }
  },
  "state": {
    "active_tab": "activity"
  }
}
