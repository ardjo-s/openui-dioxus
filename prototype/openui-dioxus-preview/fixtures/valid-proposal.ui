title = Text("Approve expense")
intro = Text("Review the MCP tool result before approving.")
merchant = Input("Merchant", merchant_field)
amount = Input("Amount", amount_field)
category = Select("Category", ["Travel", "Meals", "Software"], category_field)
details = Table(["Field", "Value"], [merchant, amount, category])
summary = Card("Expense details", details)
warning = Alert("warning", "This approval creates one typed receipt.")
approve = Button("Approve expense", ApproveExpense)
screen = Stack([title, intro, summary, warning, approve])
